import java.util.ArrayList;
import java.util.List;

public class GraphDemo {

    static final int SIZE = 4;

    
    static int[][] matrix = new int[SIZE][SIZE];

    public static void connectMatrix(int a, int b) {
        matrix[a][b] = 1;
        matrix[b][a] = 1; 
    }

    public static void displayMatrix() {
        System.out.println("\n Adjacency Matrix Representation ");

        for (int i = 0; i < SIZE; i++) {
            for (int j = 0; j < SIZE; j++) {
                System.out.print(matrix[i][j] + " ");
            }
            System.out.println();
        }
    }

    
    static List<List<Integer>> graphList = new ArrayList<>();

    public static void createList() {
        for (int i = 0; i < SIZE; i++) {
            graphList.add(new ArrayList<Integer>());
        }
    }

    public static void connectList(int a, int b) {
        graphList.get(a).add(b);
        graphList.get(b).add(a);
    }

    public static void displayList() {
        System.out.println("\n Adjacency List Representation ");

        for (int i = 0; i < SIZE; i++) {
            System.out.println(i + " -> " + graphList.get(i));
        }
    }

    
    static List<String> edgeStore = new ArrayList<>();

    public static void connectEdge(int a, int b) {
        edgeStore.add(a + " - " + b);
    }

    public static void displayEdges() {
        System.out.println("\n Edge List Representation ");

        for (String s : edgeStore) {
            System.out.println(s);
        }
    }

    
    public static void main(String[] args) {

        createList();

        int[][] links = {
                {0,1},
                {0,2},
                {0,3},
                {1,2},
                {1,3},
                {2,3}
        };

        for (int i = 0; i < links.length; i++) {

            int x = links[i][0];
            int y = links[i][1];

            connectMatrix(x, y);
            connectList(x, y);
            connectEdge(x, y);
        }

        displayMatrix();
        displayList();
        displayEdges();
    }
}
